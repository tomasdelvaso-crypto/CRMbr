{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/ventus/feedback.ts": {
      "maxDuration": 10
    },
    "api/tma-auth.ts": {
      "maxDuration": 15
    },
    "api/dispatch/track.ts": {
      "maxDuration": 15
    },
    "api/telegram.ts": {
      "maxDuration": 30
    },
    "api/act.ts": {
      "maxDuration": 60
    },
    "api/ingest.ts": {
      "maxDuration": 60
    },
    "api/plan.ts": {
      "maxDuration": 60
    },
    "api/ventus.ts": {
      "maxDuration": 60
    },
    "api/dispatch/run.ts": {
      "maxDuration": 60
    },
    "api/dispatch/jobs.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/screenshots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
