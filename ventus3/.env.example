# ════════════════════════════════════════════════════════════════════════════
# Ventus v3 — variáveis de ambiente
# ════════════════════════════════════════════════════════════════════════════
# Tudo com prefixo VITE_ ENTRA NO BUNDLE e é público. O resto só existe nas
# funções serverless (api/) e nunca chega ao telefone.
#
# CORS: o cabeçalho Access-Control-Allow-Origin é emitido pelos handlers
# (api/_lib/http.ts), NÃO pelo vercel.json. Se voltar a declará-lo lá, o
# cabeçalho sai duplicado e o navegador rejeita a resposta inteira.

# ── Cliente (público, entra no bundle) ──────────────────────────────────────
# Supabase — mesmo projeto do CRM v2 (wtrbvgqxgcfjacqcndmb)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Opcional: origem da API quando o front roda separado do backend
VITE_API_BASE_URL=

# 'off' desliga o Supabase Realtime (a app segue funcionando com pull incremental)
VITE_REALTIME=

# ── Somente servidor (Vercel env vars, NUNCA com prefixo VITE_) ─────────────

# Supabase. A service_role key ignora RLS: a autorização por vendedor é feita
# em TypeScript (api/_lib/auth.ts → exigirPropriedade), porque no Postgres o
# backend entra como '__service__' e ventus_autorizado() devolve sempre true.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Verificação LOCAL da assinatura do JWT, sem round-trip por request.
# Basta UMA das duas formas:
#   · Chaves assimétricas (ES256/RS256/EdDSA): derivadas de SUPABASE_URL, via
#     {SUPABASE_URL}/auth/v1/.well-known/jwks.json. É o caminho novo.
#   · Segredo HS256 legado: SUPABASE_JWT_SECRET. É o que o projeto tem hoje.
SUPABASE_JWT_SECRET=
# Só se o emissor não for {SUPABASE_URL}/auth/v1 (ex.: domínio próprio de auth).
SUPABASE_JWT_ISSUER=

# IA. claude-opus-5 para coaching e diagnóstico, claude-sonnet-5 para extração
# e redação, Groq whisper-large-v3-turbo para transcrição. Os model ids e os
# preços vivem numa constante única: api/_lib/anthropic.ts → MODELOS.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Telegram (webhook do bot). O secret vai no header
# X-Telegram-Bot-Api-Secret-Token e é o que impede que qualquer um poste
# updates falsos no webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Jobs agendados (pg_cron chamando as rotas via pg_net). Sem isto, qualquer um
# dispara o fechamento do dia.
CRON_SECRET=

# CORS. Lista separada por vírgulas. NUNCA '*': o v2 respondia '*' com
# credenciais, que é a combinação que o navegador rejeita e que convida
# qualquer origem. Um '*' aqui é ignorado de propósito.
ALLOWED_ORIGIN=https://ventus.ventapel.com.br
