{
  "name": "ventus3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Ventus v3 — CRM de campo da Ventapel Brasil (PPVVCC)",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint . --max-warnings 0",
    "icones": "node scripts/gerar-icones.mjs",
    "verificar:pwa": "node scripts/gerar-icones.mjs --check && node scripts/verificar-pwa.mjs",
    "url": "node scripts/url-publica.mjs",
    "url:sync": "node scripts/url-publica.mjs --sync",
    "url:check": "node scripts/url-publica.mjs --check",
    "assetlinks": "node scripts/gerar-assetlinks.mjs",
    "assetlinks:check": "node scripts/gerar-assetlinks.mjs --check",
    "assetlinks:verificar": "node scripts/gerar-assetlinks.mjs --verificar",
    "apk": "./scripts/build-apk.sh",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-query-persist-client": "^5.102.3",
    "dexie": "^4.4.5",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
