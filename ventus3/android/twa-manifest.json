{
  "packageId": "br.com.ventapel.ventus",
  "host": "ventus3.vercel.app",
  "name": "Ventus",
  "launcherName": "Ventus",
  "display": "standalone",
  "orientation": "portrait",
  "themeColor": "#2563eb",
  "themeColorDark": "#0b1220",
  "navigationColor": "#ffffff",
  "navigationColorDark": "#0b1220",
  "navigationDividerColor": "#e2e8f0",
  "navigationDividerColorDark": "#1e293b",
  "backgroundColor": "#0b1220",
  "enableNotifications": true,
  "startUrl": "/?source=twa",
  "iconUrl": "https://ventus3.vercel.app/icon-512.png",
  "maskableIconUrl": "https://ventus3.vercel.app/icon-maskable-512.png",
  "webManifestUrl": "https://ventus3.vercel.app/manifest.webmanifest",
  "fullScopeUrl": "https://ventus3.vercel.app/",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "./ventapel-ventus.keystore",
    "alias": "ventapel"
  },
  "appVersionCode": 1,
  "appVersion": "1.0.0",
  "shortcuts": [
    {
      "name": "Registrar por voz",
      "shortName": "Registrar",
      "url": "https://ventus3.vercel.app/registrar?atalho=voz",
      "chosenIconUrl": "https://ventus3.vercel.app/atalho-registrar.png"
    },
    {
      "name": "Golden Hour",
      "shortName": "Golden",
      "url": "https://ventus3.vercel.app/golden?atalho=1",
      "chosenIconUrl": "https://ventus3.vercel.app/atalho-golden.png"
    },
    {
      "name": "Hoje",
      "shortName": "Hoje",
      "url": "https://ventus3.vercel.app/?atalho=hoje",
      "chosenIconUrl": "https://ventus3.vercel.app/atalho-hoje.png"
    }
  ],
  "shareTarget": {
    "action": "https://ventus3.vercel.app/registrar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "arquivos",
          "accept": [
            "image/*",
            "audio/*",
            "application/pdf",
            "text/plain"
          ]
        }
      ]
    }
  },
  "generatorApp": "bubblewrap-cli",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": {
    "enabled": false
  },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "minSdkVersion": 23,
  "fingerprints": [],
  "additionalTrustedOrigins": [],
  "retainedBundles": [],
  "launchHandlerClientMode": "focus-existing"
}
